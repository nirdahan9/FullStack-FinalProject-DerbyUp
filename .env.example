# Copy to .env.local and fill in. Never commit the filled file.

# ── Supabase ────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses Row Level Security. Server-side cron routes only — never import
# this from a Server Component or an Action that runs for a user.
SUPABASE_SERVICE_ROLE_KEY=

# ── API-Football (api-sports.io) ────────────────────────────────
# Free tier: 100 requests/day. Supplies fixtures, results and odds.
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# ── Cron ────────────────────────────────────────────────────────
# Shared secret guarding /api/cron/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
