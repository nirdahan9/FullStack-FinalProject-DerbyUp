# Copy to .env.local and fill in. Never commit the filled file.

# ── Supabase ────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses Row Level Security. Server-side cron routes only — never import
# this from a Server Component or an Action that runs for a user.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase management (maintenance scripts only) ──────────────
# Needed by scripts/db-exec.mjs and scripts/schedule-settlement.mjs, which
# talk to the Management API rather than to the database client. The app
# itself never reads these — leave them out and the site still runs.
# Token: Dashboard → Account → Access Tokens
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ── API-Football (api-sports.io) ────────────────────────────────
# Supplies fixtures, results and odds. This project runs on the Ultra plan
# (75,000 requests/day); steady-state use is around 200/day. See
# docs/05-scale.md §10.5.
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# ── Cron ────────────────────────────────────────────────────────
# Shared secret guarding /api/cron/*. The same value is stored in Supabase
# Vault so pg_cron can call the settle and sync-live endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Live scores ─────────────────────────────────────────────────
# Kill switch for the once-a-minute live-score sync. Set to "false" to stop
# it polling the provider without a deploy or a schedule change; anything
# else, including leaving it unset, keeps it on.
LIVE_SCORES_ENABLED=true

# ── Gemini (AI advisor) ─────────────────────────────────────────
# Google AI Studio → API keys. Server-side only: it is read in Server Actions
# and never reaches the browser.
#
# Note on tiers: the newest model (gemini-3.7-flash) has a free-tier allowance
# of 20 requests, which is not enough to develop against. gemini-3.5-flash is
# free with real headroom and answers at nearly the same quality; switch to 3.7
# on a billed key. See docs/05-scale.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_GUARD_MODEL=gemini-3.5-flash-lite

# Advisor answers one person may draw per day. Enforced in Postgres by
# advisor_consume_quota(), so two tabs cannot both spend the last one.
ADVISOR_DAILY_LIMIT=10
