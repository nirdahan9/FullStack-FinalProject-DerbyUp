# ---------------------------------------------------------------
# docs/ — everything written rather than built.
#
#   docs/*.md            submission documents, handed in separately
#   docs/assignment/     the course brief
#   docs/planning/       ✅ TRACKED — the work plan, the implementation plan
#                        and the decision log. They record why the product is
#                        built the way it is, which is exactly what the
#                        assignment asks to be able to explain.
#
# `docs/*` rather than `docs/`: git cannot re-include a path whose parent
# directory is excluded, so the negation below only works if the directory
# itself is never matched.
# ---------------------------------------------------------------
docs/*
!docs/planning/
*.docx
*.doc

# ---------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p8
*.key
*service-account*.json
*firebase-adminsdk*.json

# ---------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Testing
# ---------------------------------------------------------------
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
.branches/
.temp/
supabase/.temp/

# ---------------------------------------------------------------
# Tooling / editor / OS
# ---------------------------------------------------------------
.vercel
.DS_Store
# macOS/iCloud duplicates a file as "name 2.ext" when it syncs a folder that
# is being written to. This project sits under a synced Documents folder, so
# build output collects them; they must never reach the repository.
* [0-9].*
* [0-9][0-9].*
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json
# (Vercel CLI appends `.env*` here; the Secrets block above already
#  covers it and keeps the !.env.example negation effective.)
coverage/
