# ---------------------------------------------------------------
# docs/ — everything written rather than built.
#
#   docs/*.md            working notes, handed in separately
#   docs/assignment/     the course brief
#
# `docs/*` rather than `docs/`: git cannot re-include a path whose parent
# directory is excluded, so the negations below only work if the directory
# itself is never matched.
# ---------------------------------------------------------------
docs/*
!docs/planning/
*.docx
*.doc
*.pptx
# tracked: the submission documents and the deck, as PDF only
!docs/*.pdf

# ---------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------
.env
.env.*
!.env.example
# submission-ZIP-only run script; carries the real keys
setup-and-run.mjs
*.pem
*.p8
*.key
*service-account*.json
*firebase-adminsdk*.json

# ---------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Testing
# ---------------------------------------------------------------
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
.branches/
.temp/
supabase/.temp/

# ---------------------------------------------------------------
# Tooling / editor / OS
# ---------------------------------------------------------------
.vercel
.DS_Store
# macOS/iCloud duplicates a file as "name 2.ext" when it syncs a folder that
# is being written to. This project sits under a synced Documents folder, so
# build output collects them; they must never reach the repository.
* [0-9].*
* [0-9][0-9].*
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json
# (Vercel CLI appends `.env*` here; the Secrets block above already
#  covers it and keeps the !.env.example negation effective.)
coverage/
